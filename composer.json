{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bagart/tgbot-module-summarizer",
    "description": "Chat summarizer module for the Telegram bot platform: message collection, scheduled LLM digests and an in-chat admin panel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "telegram",
        "tg-bot",
        "telegram-bot",
        "bot-platform",
        "summarizer",
        "digest",
        "llm",
        "module"
    ],
    "authors": [
        {
            "name": "BAGArt (Artur Baltaev)",
            "email": "baltaev.artur+ask@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "bagart/telegram-bot-lib": "*",
        "laravel/framework": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "BAGArt\\TelegramBotSummarizer\\": "src/",
            "BAGArt\\TelegramBotSummarizer\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BAGArt\\TelegramBotSummarizer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php ../../../vendor/bin/pest --testsuite SummarizerModule"
        ]
    },
    "repositories": {
        "telegram-bot-lib": {
            "type": "path",
            "url": "../telegram-bot-lib"
        },
        "php-async-kernel-lib": {
            "type": "path",
            "url": "../php-async-kernel-lib"
        },
        "php-async-kernel-client": {
            "type": "path",
            "url": "../php-async-kernel-client"
        },
        "baseline": {
            "type": "path",
            "url": "../telegram-platform-devops-baseline"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "bagart/telegram-platform-devops-baseline": "@dev"
    }
}
